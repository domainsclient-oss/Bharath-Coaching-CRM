rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read access to the connection test collection
    match /_connection_test/{document} {
      allow read: if true;
    }
    
    // Default rule for all other documents requires authentication
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}