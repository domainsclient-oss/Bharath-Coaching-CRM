rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Identity helpers ────────────────────────────────────────────────────

    // Reserved login domain for the student portal. Roll number ROLL001 signs
    // in as roll001@students.bharathacademy.local.
    function studentEmailPattern() {
      return '.*@students\\.bharathacademy\\.local';
    }

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userData() {
      return exists(userPath()) ? get(userPath()).data : {};
    }

    function authEmail() {
      return request.auth.token.email is string ? request.auth.token.email.lower() : '';
    }

    function myRollNo() {
      return authEmail().split('@')[0];
    }

    function myStudentId() {
      return userData().get('studentId', '');
    }

    function isStudent() {
      return signedIn() &&
             (authEmail().matches(studentEmailPattern()) || userData().get('role', '') == 'student');
    }

    function isStaff() {
      return signedIn() && !isStudent();
    }

    function isMine() {
      return isStudent() && myStudentId() != '' && resource.data.studentId == myStudentId();
    }

    function willBeMine() {
      return isStudent() && myStudentId() != '' && request.resource.data.studentId == myStudentId();
    }

    // ─── Public ──────────────────────────────────────────────────────────────

    // Connection probe used by the app's health check.
    // This MUST be public so the Login page can verify connectivity before sign-in.
    match /_connection_test/{document} {
      allow read: if true;
    }

    // ─── Staff ───────────────────────────────────────────────────────────────

    // Unchanged: full read/write across the CRM.
    match /{document=**} {
      allow read, write: if isStaff();
    }

    // ─── Students ────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isStudent() && request.auth.uid == userId;
      allow update: if isStudent()
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['settings', 'lastLogin', 'updatedAt']);
    }

    match /students/{studentId} {
      allow read: if isStudent()
                  && (studentId == myStudentId() || resource.data.rollNo.lower() == myRollNo());
    }

    match /fees/{id}              { allow read: if isMine(); }
    match /payments/{id}          { allow read: if isMine(); }
    match /attendance/{id}        { allow read: if isMine(); }
    match /studentAttendance/{id} { allow read: if isMine(); }
    match /certificates/{id}      { allow read: if isMine(); }
    match /marks/{id}             { allow read: if isMine(); }

    match /studentHomework/{docId} {
      allow read, write: if isStudent() && myStudentId() != '' && docId == myStudentId();
    }

    match /exams/{id}         { allow read: if isStudent(); }
    match /onlineExams/{id}   { allow read: if isStudent(); }
    match /questions/{id}     { allow read: if isStudent(); }
    match /homework/{id}      { allow read: if isStudent(); }
    match /timetable/{id}     { allow id: if isStudent(); }
    match /classes/{id}       { allow read: if isStudent(); }
    match /subjects/{id}      { allow read: if isStudent(); }
    match /batches/{id}       { allow read: if isStudent(); }
    match /schedules/{id}     { allow read: if isStudent(); }
    match /onlineClasses/{id} { allow read: if isStudent(); }
    match /notifications/{id} { allow read: if isStudent(); }
    match /config/{id}        { allow read: if isStudent(); }
    match /settings/{id}      { allow read: if isStudent(); }

    match /websiteNews/{id}   { allow read: if isStudent(); }

    match /testAttempts/{id} {
      allow read, delete: if isMine();
      allow create:       if willBeMine();
      allow update:       if isMine() && willBeMine();
    }

    match /studentVideoHistory/{id} {
      allow read, delete: if isMine();
      allow create:       if willBeMine();
      allow update:       if isMine() && willBeMine();
    }

    match /studentVideoBookmarks/{id} {
      allow read, delete: if isMine();
      allow create:       if willBeMine();
      allow update:       if isMine() && willBeMine();
    }
  }
}
