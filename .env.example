# Firebase Config - Replace with your project's credentials
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Center Details
NEXT_PUBLIC_CENTER_NAME="Bharath Academy"
NEXT_PUBLIC_CENTER_TAGLINE="Excellence in Education"
NEXT_PUBLIC_CENTER_LOGO="/logo.png"
NEXT_PUBLIC_CENTER_PHONE="+91 9876543210"
NEXT_PUBLIC_CENTER_EMAIL="info@bharathacademy.com"
NEXT_PUBLIC_CENTER_ADDRESS="Your Address Here"
NEXT_PUBLIC_CENTER_CITY="Chennai"
NEXT_PUBLIC_CENTER_STATE="Tamil Nadu"
NEXT_PUBLIC_CENTER_PINCODE="600001"

# Theme
NEXT_PUBLIC_THEME_PRIMARY="#1a73e8"
NEXT_PUBLIC_THEME_SECONDARY="#34a853"
NEXT_PUBLIC_THEME_ACCENT="#ea4335"
NEXT_PUBLIC_THEME_BG="#f5f5f5"
NEXT_PUBLIC_THEME_SIDEBAR="#1e293b"

# Currency & Locale
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_DATE_FORMAT="DD/MM/YYYY"

# Feature Toggles
NEXT_PUBLIC_FEATURE_ATTENDANCE="true"
NEXT_PUBLIC_FEATURE_FEES="true"
NEXT_PUBLIC_FEATURE_EXPENSES="true"
NEXT_PUBLIC_FEATURE_REPORTS="true"
NEXT_PUBLIC_FEATURE_STAFF="true"
NEXT_PUBLIC_FEATURE_SMS="false"
NEXT_PUBLIC_FEATURE_PAYMENT="false"
NEXT_PUBLIC_FEATURE_PARENT_PORTAL="false"
NEXT_PUBLIC_FEATURE_TIMETABLE="true"
NEXT_PUBLIC_FEATURE_EXAMS="true"

# Receipt Settings
NEXT_PUBLIC_RECEIPT_PREFIX="RCP"
NEXT_PUBLIC_RECEIPT_FOOTER="Thank you for your payment!"
